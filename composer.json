{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "barryvdh/laravel-dompdf": "*",
        "darkaonline/l5-swagger": "^8.6",
        "goodoneuz/pay-uz": "^2.2",
        "guzzlehttp/guzzle": "^7.2",
        "irazasyed/telegram-bot-sdk": "*",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/socialite": "^5.27",
        "laravel/telescope": "^5.16",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^3.1",
        "maennchen/zipstream-php": "3.1.2",
        "openspout/openspout": "^4.28",
        "spatie/laravel-medialibrary": "^10.7",
        "spatie/laravel-sitemap": "^7.3",
        "stevebauman/location": "^7.5",
        "symfony/css-selector": "^7.0",
        "yajra/laravel-datatables-oracle": "^10.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "laravel/ui": "^4.2",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "10.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.29"
        },
        "audit": {
            "ignore": {
                "PKSA-hc2w-9ctz-542g": "Pay-uz, Laravel 10 da ushlab turilgan, keyin yangilanadi",
                "PKSA-m5cs-t1y6-qpcs": "Laravel 10 framework advisory",
                "PKSA-3r5d-mb8f-1qw9": "Laravel 10 framework advisory",
                "PKSA-mdq4-51ck-6kdq": "Laravel 10 framework advisory",
                "PKSA-8qx3-n5y5-vvnd": "Laravel 10 framework advisory",
                "PKSA-w7xr-vk7n-rstm": "Laravel 10 framework advisory",
                "PKSA-q46n-4fdk-zjr4": "swagger/telescope advisory",
                "PKSA-qzrn-rnz3-85w1": "swagger/telescope advisory",
                "PKSA-p3rx-dfwp-73ny": "swagger/telescope advisory",
                "PKSA-7ywf-hktb-jkn9": "swagger advisory",
                "PKSA-ckwp-rt7t-c46m": "swagger/telescope advisory",
                "PKSA-4npr-btr6-zhny": "swagger advisory",
                "PKSA-njrm-6dtg-m2pc": "swagger/telescope advisory",
                "PKSA-vhvj-tvg4-96jj": "swagger advisory",
                "PKSA-nrj3-r2wg-yt8b": "swagger advisory",
                "PKSA-rvky-x3cg-y3qd": "swagger advisory",
                "PKSA-985r-hryy-555b": "swagger advisory"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
